{
  "name": "vstep-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepush": "node scripts/prepush.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny-warnings",
    "audit:listening": "python scripts/master_listening_audit.py",
    "export:listening": "node --experimental-strip-types scripts/export_all_listening.mjs",
    "verify:listening": "node --experimental-strip-types scripts/verify-all-listening.mjs",
    "transcribe:listening": "python scripts/transcribe_listening.py",
    "enrich:listening": "node scripts/enrich_listening.mjs",
    "mine:vocab": "node scripts/mine_listening_vocab.mjs",
    "mine:reading": "node --experimental-strip-types scripts/mine_reading_vocab.mjs",
    "audit:vocab": "node scripts/audit_and_update_corpus.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "postgres": "^3.4.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
