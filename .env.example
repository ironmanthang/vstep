# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# AI Master Key Pools (Optional: Comma-separated or single key)
VITE_OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
VITE_OLLAMA_API_KEYS=ollama-key1,ollama-key2
VITE_GEMINI_API_KEYS=gemini-key1,gemini-key2

# Google OAuth (Configured in Supabase Auth Provider)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
