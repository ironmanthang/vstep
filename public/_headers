# Root and HTML files: revalidate immediately
/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed assets: cache permanently (Vite includes content hashes in filename)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker, Extensions & Manifest: never serve stale scripts
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/sw-custom.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
